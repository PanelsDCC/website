        <h2 class="sidebar-nav-box-title">
            <% if (mch === 4) { %>Chapter 4 — System admin<% } else { %><a href="<%= basePath %>/system-admin/index.html" class="sidebar-nav-box-title-link">Chapter 4 — System admin</a><% } %>
