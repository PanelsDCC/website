            </li>
            <li class="sidebar-nav-step">
                <a class="sidebar-nav-row" href="<%= basePath %>/control/index.html#panels"><span class="sidebar-nav-num" aria-hidden="true">3</span><span class="sidebar-nav-label">Panels</span></a>
            </li>
        </ol>
